; IH1 setup wizard (Inno Setup 6). Built by CI: ISCC.exe /DAppVersion=x.y.z /DTestRound=N /DSourceDir=<stage> installer\IH1.iss
; V3/V4: branded with images rendered from the real IH1 formation (V4: the continuous field) (installer/branding, generated by
; tools/formation_preview), a dark header banner and explicit notes on where things go and what is kept.
; Installs the VST3 into the standard system location (C:\Program Files\Common Files\VST3), which every
; VST3 host scans (FL Studio, Cubase, ...). The standalone app is optional.

#ifndef AppVersion
  #define AppVersion "0.6.0"
#endif
#ifndef TestRound
  #define TestRound "6"
#endif
#ifndef SourceDir
  #define SourceDir "..\stage"
#endif

[Setup]
AppId={{7B3E8C51-6A0D-4E7F-9B1C-1A2D3E4F5061}
AppName=IH1
AppVersion={#AppVersion}
AppVerName=IH1 {#AppVersion} (test build, round {#TestRound})
AppPublisher=R4N-WAV
DefaultDirName={autopf}\IH1
DisableDirPage=no
DisableProgramGroupPage=yes
LicenseFile={#SourceDir}\THIRD_PARTY_NOTICES.txt
InfoBeforeFile={#SourceDir}\INSTALL_NOTES.txt
OutputDir=..\dist
OutputBaseFilename=IH1-Setup-{#AppVersion}
Compression=lzma2/max
SolidCompression=yes
; V4: a dark wizard (Inno Setup 6.6+ "dark" appearance) that matches IH1's plum / near-black world; older compilers
; build the light wizard instead of failing
#if VER >= EncodeVer(6, 6, 0)
WizardStyle=modern dark
#else
WizardStyle=modern
#endif
WizardImageFile=branding\wizard_164x314.bmp,branding\wizard_205x393.bmp,branding\wizard_246x471.bmp,branding\wizard_328x628.bmp
WizardSmallImageFile=branding\small_55.bmp,branding\small_69.bmp,branding\small_83.bmp,branding\small_110.bmp
WizardImageStretch=yes
SetupIconFile=branding\ih1.ico
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin
UninstallDisplayName=IH1 {#AppVersion}
UninstallDisplayIcon={app}\IH1.exe
SetupLogging=yes
; A host that has IH1 loaded locks IH1.vst3: ask to close it (or force it) instead of silently leaving the
; old files in place until a reboot.
CloseApplications=force
RestartApplications=no
VersionInfoVersion={#AppVersion}
VersionInfoProductName=IH1
VersionInfoDescription=IH1 {#AppVersion} setup (test build, round {#TestRound})

[Types]
Name: "full"; Description: "VST3 plug-in and standalone app"
Name: "vst3"; Description: "VST3 plug-in only"
Name: "custom"; Description: "Custom"; Flags: iscustom

[Components]
Name: "vst3"; Description: "IH1 VST3 plug-in (installed to Common Files\VST3)"; Types: full vst3 custom; Flags: fixed
Name: "standalone"; Description: "IH1 standalone app (for trying IH1 without a DAW)"; Types: full

[InstallDelete]
; remove the previous bundle completely, so no stale file of an older build can survive an update
Type: filesandordirs; Name: "{commoncf64}\VST3\IH1.vst3"

[Files]
Source: "{#SourceDir}\VST3\IH1.vst3\*"; DestDir: "{commoncf64}\VST3\IH1.vst3"; Components: vst3; Flags: recursesubdirs createallsubdirs ignoreversion
Source: "{#SourceDir}\Standalone\IH1.exe"; DestDir: "{app}"; Components: standalone; Flags: ignoreversion skipifsourcedoesntexist
Source: "{#SourceDir}\README.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#SourceDir}\THIRD_PARTY_NOTICES.txt"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\IH1"; Filename: "{app}\IH1.exe"; Components: standalone
Name: "{autoprograms}\IH1 README"; Filename: "{app}\README.md"

[Run]
Filename: "{app}\IH1.exe"; Description: "Launch the IH1 standalone app"; Components: standalone; Flags: nowait postinstall skipifsilent unchecked

[Messages]
WelcomeLabel1=IH1 {#AppVersion}
WelcomeLabel2=This installs the IH1 creative FX instrument (VST3, 64-bit) by R4N-WAV.%n%nTest build, round {#TestRound}.%n%nThe plug-in goes to the standard VST3 folder:%nC:\Program Files\Common Files\VST3\IH1.vst3%n%nYour own presets (Documents\IH1\Presets) are never changed or removed by this installer or by uninstalling.%n%nClose FL Studio and any other DAW using IH1 before continuing.
FinishedLabel=IH1 {#AppVersion} has been installed.%n%nPlug-in: C:\Program Files\Common Files\VST3\IH1.vst3%nYour presets: Documents\IH1\Presets (kept as they were)%n%nFL Studio: Options > Manage plugins > Find more plugins, then add IH1 to a mixer insert. If an older IH1 still loads, tick "Rescan previously verified plugins" and rescan.%nCubase: Studio > VST Plug-in Manager > rescan.%n%nThe build shown under the IH1 wordmark should read v{#AppVersion}.

[Code]
// V3 branding: a near-black header banner with light text (the wizard pages themselves stay in the system
// style, readable at every DPI and contrast setting)
procedure InitializeWizard();
begin
  WizardForm.MainPanel.Color := $0A0608;
  WizardForm.PageNameLabel.Font.Color := $F7E3E9;
  WizardForm.PageDescriptionLabel.Font.Color := $BC939C;
end;

// An older IH1.vst3 in the per-user VST3 folder (or the 32-bit one) can be loaded by a host instead of this
// one. Warn so the user can remove it.
procedure CurStepChanged(CurStep: TSetupStep);
var
  Others: String;
begin
  if CurStep = ssPostInstall then
  begin
    Others := '';
    if DirExists(ExpandConstant('{localappdata}\Programs\Common\VST3\IH1.vst3')) then
      Others := Others + #13#10 + ExpandConstant('{localappdata}\Programs\Common\VST3\IH1.vst3');
    if DirExists(ExpandConstant('{commoncf32}\VST3\IH1.vst3')) and (ExpandConstant('{commoncf32}') <> ExpandConstant('{commoncf64}')) then
      Others := Others + #13#10 + ExpandConstant('{commoncf32}\VST3\IH1.vst3');
    if Others <> '' then
      MsgBox('IH1 {#AppVersion} is installed in C:\Program Files\Common Files\VST3.' + #13#10#13#10 +
             'Another, older copy of IH1 was found, which a host may load instead:' + Others + #13#10#13#10 +
             'Delete it, then rescan plug-ins in your DAW.', mbInformation, MB_OK);
  end;
end;
